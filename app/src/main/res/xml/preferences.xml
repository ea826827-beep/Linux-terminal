<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Terminal Appearance">

        <ListPreference
            android:key="theme_selection"
            android:title="Theme Selection"
            android:defaultValue="Dark Mode"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:dialogTitle="Select Theme"/>

        <ListPreference
            android:key="font_size"
            android:title="Font Size"
            android:defaultValue="14"
            android:entries="@array/font_sizes"
            android:entryValues="@array/font_size_values"
            android:dialogTitle="Font Size"/>

    </PreferenceCategory>

    <PreferenceCategory android:title="Kali Linux Environment">

        <SwitchPreferenceCompat
            android:key="auto_start_kali"
            android:title="Auto-start Kali"
            android:summary="Launch Kali terminal on app startup"
            android:defaultValue="false"/>

        <SwitchPreferenceCompat
            android:key="persistent_filesystem"
            android:title="Persistent Filesystem"
            android:summary="Preserve Kali Linux filesystem between sessions"
            android:defaultValue="true"/>

    </PreferenceCategory>

    <PreferenceCategory android:title="About">

        <Preference
            android:title="Version"
            android:summary="KALI MOBILE v1.0"/>

        <Preference
            android:title="Source Code"
            android:summary="GitHub Repository"/>

        <Preference
            android:title="Report Issues"
            android:summary="Issue Tracker"/>
    </PreferenceCategory>

</PreferenceScreen>