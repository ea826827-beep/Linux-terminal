<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <!-- Top toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1A1A2E"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:contentDescription="Python info"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="KALI PYTHON INTEGRATION"
            android:textColor="#00FFEF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:gravity="center_vertical"/>

        <TextView
            android:id="@+id/pyStatusText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Python: Not ready"
            android:textColor="#FF5555"
            android:textSize="12sp"
            android:typeface="monospace"
            android:gravity="center_vertical"
            android:paddingStart="8dp"/>
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnPyCheckPython"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Check Python 3"
            android:textColor="#0D0D0D"
            android:background="#00FFEF"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnPyCreateFile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="New .py File"
            android:textColor="#00FFEF"
            android:background="#1A1A2E"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnPyRun"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Run Script"
            android:textColor="#00FFEF"
            android:background="#1A1A2E"
            android:padding="8dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Script path -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Script Path"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="italic"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/pyScriptPathEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="/root/hello.py or ./script.py"
            android:textColor="#00FFEF"
            android:textColorHint="#666666"
            android:textSize="14sp"
            android:typeface="monospace"
            android:background="#16161E"
            android:padding="10dp"/>
    </LinearLayout>

    <!-- Python code editor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Python Code"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="italic"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/pyCodeEdit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="# Enter Python code here\nprint('Hello Kali')\n"
            android:textColor="#00FFEF"
            android:textColorHint="#666666"
            android:textSize="14sp"
            android:typeface="monospace"
            android:background="#16161E"
            android:padding="10dp"
            android:gravity="top"
            android:minLines="8"
            android:inputType="textMultiLine"/>
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/pyProgressBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:progressTint="#00FFEF"/>

    <!-- Output panel -->
    <ScrollView
        android:id="@+id/pyScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbarStyle="outsideInset">

        <TextView
            android:id="@+id/pyOutputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000000"
            android:textColor="#00FF41"
            android:textSize="13sp"
            android:typeface="monospace"
            android:padding="12dp"
            android:textIsSelectable="true"
            android:textCursorDrawable="@null"/>
    </ScrollView>

</LinearLayout>