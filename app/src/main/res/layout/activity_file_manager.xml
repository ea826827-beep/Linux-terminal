<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <!-- Top toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1A1A2E"
        android:titleTextColor="#00FFEF"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnCreateFolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="New Folder"
            android:textColor="#0D0D0D"
            android:background="#00FFEF"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:onClick="onCreateFolderClick"/>

        <Button
            android:id="@+id/btnCreateFile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="New File"
            android:textColor="#0D0D0D"
            android:background="#00FFEF"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:onClick="onCreateFileClick"/>

        <Button
            android:id="@+id/btnGoUp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=".. Up"
            android:textColor="#00FFEF"
            android:background="#1A1A2E"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:onClick="onGoUpClick"/>
    </LinearLayout>

    <!-- Current path indicator -->
    <TextView
        android:id="@+id/pathText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#888888"
        android:textSize="12sp"
        android:typeface="monospace"
        android:padding="8dp"/>

    <!-- File list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#16161E"
        android:scrollbars="vertical"/>

</LinearLayout>